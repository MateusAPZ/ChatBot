{
  "name": "pesquisa-whats-api",
  "version": "2.0.0",
  "description": "WhatsApp Chatbot Studio - Full-stack Node.js (TypeScript) & React",
  "scripts": {
    "dev:backend": "npm run --prefix backend dev",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run --prefix backend build",
    "build:frontend": "npm run --prefix frontend build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm run --prefix backend start"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "twilio": "^5.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  }
}
